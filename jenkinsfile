node('ubuntu-agent') {

    try {

        stage('Checkout') {

            checkout scmGit(
                branches: [[name: '*/master']],
                extensions: [],
                userRemoteConfigs: [[
                    url: 'https://github.com/opstree/spring3hibernate.git'
                ]]
            )
        }


        stage('Compile') {

            sh '''
                echo "===== Java Version ====="
                java -version

                echo "===== Maven Version ====="
                mvn -version

                echo "===== Fixing Maven Compiler Plugin ====="

                python3 - <<'PY'
from pathlib import Path
import re

pom = Path("pom.xml")
text = pom.read_text()

pattern = r'(<artifactId>maven-compiler-plugin</artifactId>\\s*<version>)2\\.3\\.2(</version>\\s*<configuration>\\s*<source>)1\\.6(</source>\\s*<target>)1\\.6(</target>)'

new_text, count = re.subn(
    pattern,
    r'\\g<1>3.8.1\\g<2>1.8\\g<3>1.8\\g<4>',
    text,
    count=1
)

if count == 0:
    print("Compiler plugin already updated or original configuration not found")
else:
    pom.write_text(new_text)
    print("Maven Compiler Plugin updated successfully")
PY

                echo "===== Maven Compiler Plugin Configuration ====="

                grep -A8 -B2 "maven-compiler-plugin" pom.xml

                echo "===== Maven Clean Compile ====="

                mvn clean compile
            '''
        }


        stage('Unit Test and OWASP Dependency Check') {

            parallel(

                'Unit Test': {

                    stage('Unit Test') {

                        sh '''
                            echo "===== Running Unit Tests ====="

                            mvn test \
                                -DargLine="--add-opens java.base/java.lang=ALL-UNNAMED"
                        '''
                    }
                },


                'OWASP Dependency Check': {

                    stage('OWASP Dependency Check') {

                        withCredentials([
                            string(
                                credentialsId: 'nvd-api-key',
                                variable: 'NVD_API_KEY'
                            )
                        ]) {

                            echo "===== Running OWASP Dependency Check ====="

                            dependencyCheck(
                                additionalArguments: "--scan ./ --nvdApiKey ${NVD_API_KEY}",
                                odcInstallation: 'Dependency-Check'
                            )

                            dependencyCheckPublisher(
                                pattern: '**/dependency-check-report.xml'
                            )
                        }
                    }
                }
            )
        }


        stage('GitLeaks') {

            sh '''
                echo "===== Running GitLeaks ====="

                gitleaks detect \
                    --source . \
                    --no-git \
                    --report-format json \
                    --report-path gitleaks-report.json
            '''

            archiveArtifacts(
                artifacts: 'gitleaks-report.json',
                allowEmptyArchive: true
            )
        }


        stage('Package') {

            sh '''
                echo "===== Fixing Maven WAR Plugin ====="

                python3 - <<'PY'
from pathlib import Path
import re

pom = Path("pom.xml")
text = pom.read_text()

pattern = r'(<artifactId>maven-war-plugin</artifactId>\\s*<version>)2\\.1\\.1(</version>)'

new_text, count = re.subn(
    pattern,
    r'\\g<1>3.4.0\\g<2>',
    text,
    count=1
)

if count == 0:
    print("WAR plugin 2.1.1 not found - checking current version")
else:
    pom.write_text(new_text)
    print("Maven WAR Plugin updated successfully")
PY

                echo "===== Maven WAR Plugin Configuration ====="

                grep -A3 -B2 "maven-war-plugin" pom.xml

                echo "===== Creating WAR Package ====="

                mvn package -DskipTests
            '''

            archiveArtifacts(
                artifacts: 'target/*.war, target/*.jar',
                allowEmptyArchive: true
            )
        }

    }


    catch (err) {

        echo "Build failed: ${err}"

        currentBuild.result = 'FAILURE'

        throw err
    }


    finally {

        echo "===== Cleaning Workspace ====="

        deleteDir()
    }
}
